{
  "name": "TV Tracker",
  "short_name": "TV",
  "description": "Track what you watch, what is next, and what just aired.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f1117",
  "theme_color": "#0f1117",
  "icons": [
