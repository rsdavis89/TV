# Copy to .env and adjust. Every value here is optional — the defaults in
# app/config.py are what runs if you set nothing.
#
# NOTE FOR HOSTED PLATFORMS (Railway, Render, Fly...): some of them scan this
# file and offer to add every variable in it for you. Do not accept that
# wholesale. The three below are commented out precisely because the values
# that suit a laptop are wrong on a host:
#
#   TV_DATA_DIR  must point at your mounted volume, e.g. /data — not ./data,
#                which is inside the container and is erased on every restart.
#   TV_PORT      must stay unset. Platforms assign a port through PORT and
#                route traffic to it; setting TV_PORT overrides that and
#                nothing can reach the app.
#   TV_HOST      is already 0.0.0.0 by default.
#
# On a host, set TV_PASSWORD and TV_DATA_DIR. That is all you need.

# Where the SQLite database lives. Back this directory up.
# TV_DATA_DIR=./data
# TV_DB_PATH=./data/tv.db

# Leave TV_PASSWORD empty for no login (fine on a home network).
# Set it to anything if the app is reachable from the internet.
TV_PASSWORD=
# TV_SECRET_KEY=            # generated and stored automatically if unset
# TV_SESSION_DAYS=90

# How often to check TVmaze for new episodes of the shows you follow.
TV_REFRESH_INTERVAL_HOURS=6
TV_REFRESH_ON_START=true
# Re-sync a show at least this often even if TVmaze reports no change.
TV_STALE_SHOW_HOURS=168

# Automatic backups of your watch history. This is the only data the app
# cannot fetch again, so backups are on by default.
TV_BACKUP_ENABLED=true
# TV_BACKUP_DIR=./data/backups
TV_BACKUP_INTERVAL_HOURS=24
TV_BACKUP_KEEP=14

# TV_HOST=0.0.0.0
# TV_PORT=8484
